{
  "name": "aee_digital_api",
  "version": "0.0.1",
  "description": "API de informações da Aliança",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "docker:clean": "docker-compose down -v",
    "pre-deploy": "npm run lint && npm run test:cov && npm run build && npm run test:e2e",
    "geocode:centros": "node scripts/geocode-centros.mjs",
    "summary-v2:backfill": "node -r ts-node/register scripts/summary-v2-backfill.ts",
    "centros:backfill-contacts": "node -r ts-node/register scripts/backfill-centro-public-contacts.ts"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.0",
    "@fastify/cors": "^11.3.0",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "cacheable": "^2.5.0",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "express": "^5.2.1",
    "fastify": "^5.11.0",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.2",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.19.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/aws-lambda": "^8.10.162",
    "@types/cache-manager": "^4.0.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/mongodb": "^4.0.6",
    "@types/mongoose": "^5.11.96",
    "@types/supertest": "^7.2.1",
    "@types/winston": "^2.4.4",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fast-uri": "^3.1.4",
    "find-my-way": "^9.7.0",
    "js-yaml": "^5.2.3"
  }
}
