# ======================================
# Desenvolvimento Local
# ======================================

# Node Environment
NODE_ENV=development
PORT=5000

# ======================================
# BANCO DE DADOS - MongoDB
# ======================================
# Use a mesma conexão que em produção
MONGODB_URI=replace-with-local-mongodb-uri
AWS_REGION=us-east-1
DASHBOARD_PROJECTIONS_FUNCTION_NAME=dashboard-projections
DASHBOARD_PROJECTIONS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/115186094843/dashboard-projections-queue
MONGODB_MAX_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
ENABLE_MONGO_CHANGE_STREAMS=false

# ======================================
# Logging
# ======================================
LOG_LEVEL=debug

# ======================================
# API Configuration
# ======================================
# CORS origin - onde seu frontend está rodando
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ======================================
# Atualização operacional de localização
# ======================================
# Usado pela API para proteger PUT /centros/:id/localizacao.
LOCATION_UPDATE_TOKEN=replace-with-local-location-update-token

# Variáveis usadas somente pelo script scripts/geocode-centros.mjs.
# GEOAPIFY_API_KEY=
# GEOCODING_TIMEOUT_MS=15000
# MAX_CALLS=2800
# INTERVAL_MS=300
GEOAPIFY_API_KEY=replace-with-local-geoapify-api-key
PARAMETER_PROJECT=aee-digital
PARAMETER_ENVIRONMENT=
