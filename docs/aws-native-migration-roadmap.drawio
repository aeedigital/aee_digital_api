<mxfile host="app.diagrams.net" modified="2026-07-31T12:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="roadmap" name="Roadmap de migração">
    <mxGraphModel dx="1800" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Roadmap incremental — da Lambda monolítica às capacidades AWS-native" style="text;html=1;fontSize=24;fontStyle=1;align=left;strokeColor=none;fillColor=none;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="CloudFront → Lambda Function URL é a entrada oficial; cada corte ocorre por origin/behavior, com retorno ao monólito" style="text;html=1;fontSize=13;align=left;strokeColor=none;fillColor=none;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1400" height="30" as="geometry"/></mxCell>

        <mxCell id="baseline" value="HOJE&#xa;Lambda monolítica" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="140" height="100" as="geometry"/></mxCell>

        <mxCell id="p0" value="&lt;b&gt;FASE 0&lt;/b&gt;&lt;br&gt;Baseline controlável" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="225" y="120" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p0body" value="• inventário de 100% das rotas&lt;br&gt;• suíte integration/contract/e2e&lt;br&gt;• legado × Function URL&lt;br&gt;• smoke pós-deploy + rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="225" y="205" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="g0" value="Gate: todas as rotas verdes, equivalência comprovada e rollback aprovado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="225" y="350" width="200" height="70" as="geometry"/></mxCell>

        <mxCell id="p1" value="&lt;b&gt;FASE 1&lt;/b&gt;&lt;br&gt;Modularizar no monólito" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="465" y="120" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p1body" value="• limites e repositórios&lt;br&gt;• remover watchers/cache local&lt;br&gt;• conexão Mongo limitada&lt;br&gt;• testes de arquitetura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="465" y="205" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="g1" value="Gate: módulos empacotáveis sem mudar HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="465" y="350" width="200" height="60" as="geometry"/></mxCell>

        <mxCell id="p2" value="&lt;b&gt;FASE 2&lt;/b&gt;&lt;br&gt;Extrair geocodificação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="705" y="120" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p2body" value="• outbox → SQS direto&lt;br&gt;• DLQ + worker idempotente&lt;br&gt;• PENDENTE no comando&lt;br&gt;• Scheduler e cota diária" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="705" y="205" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="g2" value="Gate: cadastro independente do Geoapify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="705" y="350" width="200" height="60" as="geometry"/></mxCell>

        <mxCell id="p3" value="&lt;b&gt;FASE 3&lt;/b&gt;&lt;br&gt;Read models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="945" y="120" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p3body" value="• DynamoDB por consulta&lt;br&gt;• projection-worker&lt;br&gt;• mesma Function URL&lt;br&gt;• shadow read + medir lag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="945" y="205" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="g3" value="Gate: payload equivalente e lag no SLO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="945" y="350" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="freeStop" value="Estado final válido para small/free: CloudFront + uma Function URL modular + workers + SQS + DynamoDB, sem API Gateway." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="705" y="440" width="440" height="65" as="geometry"/></mxCell>

        <mxCell id="p4" value="&lt;b&gt;FASE 4 — OPCIONAL&lt;/b&gt;&lt;br&gt;Separar APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1185" y="120" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p4body" value="• Function URL + OAC por API&lt;br&gt;• behaviors por path&lt;br&gt;• IAM e deploy isolados&lt;br&gt;• origin modular de fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1185" y="205" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="g4" value="Gate: deploy e IAM independentes por capacidade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1185" y="350" width="200" height="60" as="geometry"/></mxCell>

        <mxCell id="p5" value="&lt;b&gt;FASE 5&lt;/b&gt;&lt;br&gt;Migrar dados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1425" y="120" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p5body" value="• capacidade por vez&lt;br&gt;• backfill → shadow → corte&lt;br&gt;• DynamoDB Streams&lt;br&gt;• rollback de leitura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1425" y="205" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="g5" value="Gate: sem dual-write indefinido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1425" y="350" width="200" height="60" as="geometry"/></mxCell>

        <mxCell id="p6" value="&lt;b&gt;FASE 6&lt;/b&gt;&lt;br&gt;Descomissionar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1425" y="485" width="200" height="75" as="geometry"/></mxCell>
        <mxCell id="p6body" value="• desligar monólito sem tráfego&lt;br&gt;• remover REST API Gateway&lt;br&gt;• desabilitar CloudFront API antigo&lt;br&gt;• revisar custo e DR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1425" y="570" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="target" value="ALVO&#xa;capacidades independentes" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1645" y="580" width="130" height="100" as="geometry"/></mxCell>

        <mxCell id="rollback" value="&lt;b&gt;Trilho de segurança em todas as fases&lt;/b&gt;&lt;br&gt;Contrato compatível · feature flag/route switch · canário · shadow traffic · alarmes · rollback por origin/behavior CloudFront ou alias Lambda · eventos tolerantes a versões N e N-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1"><mxGeometry x="225" y="760" width="1550" height="90" as="geometry"/></mxCell>
        <mxCell id="rule" value="Regra de decisão: separar compute antes de migrar banco; criar projeções antes de separar consultas; nunca dividir por endpoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="225" y="885" width="1550" height="70" as="geometry"/></mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#6b7280;" edge="1" parent="1" source="baseline" target="p0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#6b7280;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#6b7280;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#6b7280;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#6b7280;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#6b7280;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="após cortes estáveis" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#6b7280;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1660" y="160"/><mxPoint x="1660" y="520"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=3;strokeColor=#82b366;" edge="1" parent="1" source="p6" target="target"><mxGeometry relative="1" as="geometry"/></mxCell>
