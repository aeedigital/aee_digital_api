{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aee-digital:schemas:center-summary-refresh:v1",
  "title": "Center summary refresh event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "summaryId",
    "centroId",
    "sourceVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "center.summary-refresh.v1"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "summaryId": {
      "type": "string",
      "minLength": 1
    },
    "centroId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "updatedAt",
        "createdAt",
        "summaryId"
      ],
      "properties": {
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "summaryId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
